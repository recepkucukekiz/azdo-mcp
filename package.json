{
  "name": "azdo-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets Claude read and update Azure DevOps work items, repositories and pull requests",
  "type": "module",
  "bin": {
    "azdo-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "dev": "node src/index.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "azure-devops",
    "azure-boards",
    "work-items",
    "pull-requests"
  ],
  "author": "Recep Kucukekiz",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  }
}
